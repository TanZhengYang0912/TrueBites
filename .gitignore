# Dependencies
node_modules/
.pnp
.pnp.js

# Environment variables — never commit real keys
.env
.env.local
.env.*.local

# Vite build output
dist/
dist-ssr/

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/settings.json
*.swp

# Coverage
coverage/
.coverage
*.coverage

# AI pipeline runtime outputs (audio files, transcripts) — large binary files
backend/outputs/

# Standalone yt-dlp binary — fetched by scripts/installYtDlp.js, not source
backend/bin/

# Test files (local only)
backend/tests/

# Run-artifacts written by the admin one-off scripts (fetchVendorCoverPhotos.js,
# fetchVendorGalleryFrames.js, auditOrphanStorage.js, etc.) — logs/review lists
# that change on every run, not hand-authored source.
backend/scripts/*.json

# Local QA captures and generated review notes
design-qa*.png
design-qa.md

# Frontend tooling metadata
.vite/
*.tsbuildinfo
/docs
/frontend/responsive-output
