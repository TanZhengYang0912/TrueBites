venv/
venv-new/
venv312/
venv313/
.venv/
backend/venv/
backend/venv-new/
backend/venv312/
backend/venv313/
backend/.venv/

# Python cache
backend/routes/__pycache__/
backend/services/__pycache__/

# Test files (local only)
backend/tests/

# Local QA captures and generated review notes
design-qa*.png
design-qa.md

# Frontend tooling metadata
.vite/
*.tsbuildinfo
/docs
/frontend/responsive-output
