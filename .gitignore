# Migration script progress — local only
backend/scripts/geocode_log.json

# Python bytecode cache
__pycache__/
*.pyc
*.pyo

# AI pipeline runtime outputs (audio files, transcripts) — large binary files
backend/outputs/

# Downloaded ML model files (e.g. the YuNet face-detection model) — fetched
# once at runtime and cached locally, not project source.
backend/models/

