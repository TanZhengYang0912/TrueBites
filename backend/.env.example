# SERVER key — used by Node for Directions + Geocoding API calls.
# Get your key from Google Cloud Console → APIs & Services → Credentials
# Enable: Maps JavaScript API, Geocoding API, Directions API
GOOGLE_API_KEY=your_google_api_key_here

# Supabase — get from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_secret_key_here

# Automatic vendor-photo discovery — free/registration-only, no billing.
# Can be left unset; that provider is simply skipped (the other providers,
# including the existing TikTok-oEmbed source, still work).
#
# Mapillary — free access token from https://www.mapillary.com/dashboard/developers
MAPILLARY_ACCESS_TOKEN=your_mapillary_access_token_here

PORT=4000

# ── AI content pipeline (video → transcript → vendor draft) ─────────────────
# Requires yt-dlp and ffmpeg/ffprobe available as external tools — see
# `npm run setup:ytdlp` (fetches yt-dlp into backend/bin/) and install ffmpeg
# separately (e.g. via your OS package manager). Required.
GROQ_API_KEY=your_groq_api_key_here

# Whisper language hint for Melaka food content (Malay with English code-switching)
WHISPER_LANGUAGE=ms

# Only needed if yt-dlp isn't in backend/bin/ or on PATH under its default name
# YTDLP_PATH=/custom/path/to/yt-dlp

# Base URL used to build links to extracted gallery-photo frames served from
# /outputs. Defaults to http://localhost:<PORT>; set this to the deployed
# backend URL in production.
# PUBLIC_BASE_URL=http://localhost:4000

# Hours to keep AI job artifacts (audio/transcripts/frames) in backend/outputs/
# before the hourly sweeper deletes them. Defaults to 24.
# AI_OUTPUTS_TTL_HOURS=24
