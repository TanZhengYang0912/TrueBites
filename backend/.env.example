# SERVER key — used by Node for Directions, Geocoding, and (for the "Find
# Photos Automatically" admin panel) Places photo discovery.
# Get your key from Google Cloud Console → APIs & Services → Credentials
# Enable: Maps JavaScript API, Geocoding API, Directions API, Places API
GOOGLE_API_KEY=your_google_api_key_here

# Supabase — get from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_secret_key_here

# Set to 1 to log each photo-discovery provider's raw request/response and
# scored candidates to the server console — useful when a vendor's "Find
# Photos Automatically" isn't turning up what you expect. Off by default.
# PHOTO_DISCOVERY_DEBUG=1

PORT=4000

# ── AI content pipeline (video → transcript → vendor draft) ─────────────────
# yt-dlp and ffmpeg/ffprobe are both fetched automatically by `npm install`
# (yt-dlp via a postinstall hook into backend/bin/; ffmpeg/ffprobe via the
# ffmpeg-static/ffprobe-static npm packages) — nothing to install by hand.
# GROQ_API_KEY itself is still required.
GROQ_API_KEY=your_groq_api_key_here

# Whisper language hint for Melaka food content (Malay with English code-switching)
WHISPER_LANGUAGE=ms

# Only needed if yt-dlp isn't in backend/bin/ or on PATH under its default name
# YTDLP_PATH=/custom/path/to/yt-dlp

# Only needed to override the ffmpeg-static/ffprobe-static npm binaries with
# a system install (e.g. a platform those packages don't ship a binary for)
# FFMPEG_PATH=/custom/path/to/ffmpeg
# FFPROBE_PATH=/custom/path/to/ffprobe

# Base URL used to build links to extracted gallery-photo frames served from
# /outputs. Defaults to http://localhost:<PORT>; set this to the deployed
# backend URL in production.
# PUBLIC_BASE_URL=http://localhost:4000

# Hours to keep AI job artifacts (audio/transcripts/frames) in backend/outputs/
# before the hourly sweeper deletes them. Defaults to 24.
# AI_OUTPUTS_TTL_HOURS=24
