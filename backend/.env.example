# SERVER key — used by Node for Directions + Geocoding API calls.
# Get your key from Google Cloud Console → APIs & Services → Credentials
# Enable: Maps JavaScript API, Geocoding API, Directions API
GOOGLE_API_KEY=your_google_api_key_here

# Supabase — get from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_secret_key_here

# Whisper language hint for Melaka food content (Malay with English code-switching)
WHISPER_LANGUAGE=ms

# Automatic vendor-photo discovery — both free/registration-only, no billing.
# Either or both can be left unset; that provider is simply skipped (the
# other provider(s), and the existing TikTok-oEmbed source, still work).
#
# Mapillary — free access token from https://www.mapillary.com/dashboard/developers
MAPILLARY_ACCESS_TOKEN=your_mapillary_access_token_here
# Flickr — free API key from https://www.flickr.com/services/apps/create/apply
FLICKR_API_KEY=your_flickr_api_key_here

PORT=4000
# URL of the separately deployed FastAPI service. Leave unset when running
# only the Node API; AI routes will otherwise default to localhost:8000.
AI_SERVICE_BASE=http://localhost:8000
AI_INTERNAL_KEY=replace-with-a-long-random-internal-key
